## AWS configuration -- IAM, S3 connection for the application
AWS_ACCESS_KEY_ID = "your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY = "your_aws_secret_access_key"
AWS_REGION = "us-east-1"
S3_BUCKET = "enterprise-qa-documents-jarharsh1-2026"

## Bedrock configuration -- LLM and embedding model for the application 
BEDROCK_EMBED_MODEL = amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL = amazon.nova-2-lite-v1:0
EMBED_DIM = 1024

## Pinecone configuration -- Vector database connection for the application
PINECONE_API_KEY = "your_pinecone_api_key"
PINECONE_INDEX_HOST = "your_pinecone_index_host"
PINECONE_CLOUD = aws
PINECONE_REGION = "your_pinecone_region"
PINECONE_READY_TIMEOUT = 180

## Postgres configuration -- RDS database connection for the application
DATABASE_URL = "your_postgres_database_url"

## Rius configuration -- Observability and monitoring for the application
RIUS_API_KEY = "your_rius_api_key"
RIUS_SERVICE_NAME = "your_rius_service_name"
RIUS_DISABLED = false
RIUS_CAPTURE_CONTENT = false
